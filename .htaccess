# ============================================================
# .htaccess — Configuración para IONOS / Servidores Apache
# Solución para Modelos 3D (.glb, .gltf, .obj, .stl), Carrusel y CORS
# ============================================================

# 1. Declaración de MIME Types para archivos 3D y multimedia
<IfModule mod_mime.c>
    AddType model/gltf-binary .glb
    AddType model/gltf+json .gltf
    AddType model/stl .stl
    AddType text/plain .obj
    AddType video/mp4 .mp4
    AddType video/x-matroska .mkv
</IfModule>

# 2. Configuración de Cabeceras CORS (Acceso cruzado para CDNs de Three.js)
<IfModule mod_headers.c>
    Header set Access-Control-Allow-Origin "*"
    Header set Access-Control-Allow-Methods "GET, POST, OPTIONS"
    Header set Access-Control-Allow-Headers "Origin, X-Requested-With, Content-Type, Accept"
</IfModule>

# 3. Habilitar compresión GZIP para scripts e imágenes
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css text/javascript application/javascript application/json model/gltf+json
</IfModule>

# 4. Asegurar codificación UTF-8
AddDefaultCharset UTF-8
